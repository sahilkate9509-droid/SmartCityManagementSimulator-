# =========================================================================
# Unity .gitignore
# =========================================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored if the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Visual Studio / JetBrains Rider / VS Code files
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash reports
sysinfo.txt
*.stackdump

# Builds
*.apk
*.aab
*.unitypackage
*.app

# =========================================================================
# Python & Environment
# =========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.env
.venv/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# =========================================================================
# Operating System files
# =========================================================================
[Dd]esktop.ini
Thumbs.db
.DS_Store

# =========================================================================
# Local Documentation & Black Book Backup (excluded from game repository)
# =========================================================================
_BlackBook_Documentation_Backup/
*.pdf
*.pptx
*.ppt
Presentation_Defense_Guide.md
Smart_City_Management_Simulator_Test_Cases.*
docs_figures/

