# ==============================================================================
# Smart City Management Simulator — Backend Configuration
# ==============================================================================

# Option 1: Supabase (Free Cloud PostgreSQL)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Option 2: Neon.tech (Serverless Cloud PostgreSQL)
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[ENDPOINT].neon.tech/neondb?sslmode=require

# Option 3: Local Docker PostgreSQL
# DATABASE_URL=postgresql://smartcity:smartcity_secure_pass_2026@localhost:5432/smartcity_db

# Option 4: Local Zero-Config SQLite (Default fallback if left blank)
DATABASE_URL=sqlite:///./smartcity.db

# Server port
PORT=8000
